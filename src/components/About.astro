---
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="about" class="reveal scroll-mt-20 py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mb-12 text-center">
      <p class="eyebrow mb-4">{t.about.eyebrow}</p>
      <h2 class="mb-4 text-3xl font-extrabold tracking-tight md:text-4xl">{t.about.title}</h2>
      <p class="mx-auto max-w-2xl text-lg text-muted">
        {t.about.subtitle}
      </p>
    </div>
    <div class="reveal-stagger grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {t.about.cards.map((c) => (
        <article class="card-hover rounded-2xl border border-border bg-card p-6">
          <div class="mb-4 text-3xl">{c.icon}</div>
          <h3 class="mb-2 text-lg font-bold">{c.title}</h3>
          <p class="text-sm text-muted">{c.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
