---
import { getUi, type Lang } from "../i18n";
import { GITHUB_ORG_URL } from "../config";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="activity" class="reveal scroll-mt-20 border-t border-line py-24">
  <div class="mx-auto max-w-5xl px-6">
    <p class="eyebrow mb-6">{t.activity.eyebrow}</p>
    <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl">{t.activity.title}</h2>
    <p class="mb-12 max-w-2xl text-lg text-muted">{t.activity.subtitle}</p>
    <ul
      id="activity-feed"
      class="border-t border-line"
      data-org-url={GITHUB_ORG_URL}
      data-error={t.activity.error}
      data-lang={lang}
      data-labels={JSON.stringify({
        PushEvent: t.activity.pushed,
        PullRequestEvent: t.activity.pr,
        IssuesEvent: t.activity.issue,
        CreateEvent: t.activity.created,
        ReleaseEvent: t.activity.release,
        WatchEvent: t.activity.starred,
        other: t.activity.other,
      })}
    >
      {[0, 1, 2, 3].map(() => (
        <li class="flex items-center gap-4 border-b border-line py-4" aria-hidden="true">
          <span class="skeleton h-8 w-8 shrink-0"></span>
          <span class="skeleton h-3.5 min-w-0 flex-1"></span>
          <span class="skeleton h-3 w-16 shrink-0"></span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  interface GhEvent {
    id: string;
    type: string;
    created_at: string;
    repo: { name: string };
    actor: { display_login: string; avatar_url: string };
  }

  const feed = document.getElementById("activity-feed") as HTMLUListElement | null;

  if (feed && !feed.dataset.init) {
    feed.dataset.init = "1";
    const orgUrl = feed.dataset.orgUrl!;
    const lang = feed.dataset.lang === "ru" ? "ru-RU" : "en-US";
    const labels = JSON.parse(feed.dataset.labels!) as Record<string, string>;
    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

    const rtf = new Intl.RelativeTimeFormat(lang, { numeric: "auto" });
    const relTime = (iso: string) => {
      const diff = Date.now() - new Date(iso).getTime();
      const mins = Math.round(diff / 60000);
      if (mins < 60) return rtf.format(-mins, "minute");
      const hours = Math.round(mins / 60);
      if (hours < 24) return rtf.format(-hours, "hour");
      return rtf.format(-Math.round(hours / 24), "day");
    };

    const fail = () => {
      feed.innerHTML = `<li class="border-b border-line py-5 text-sm text-muted">
        <a href="${orgUrl}" target="_blank" rel="noopener" class="link-cyan">${esc(feed.dataset.error!)}</a>
      </li>`;
    };

    fetch("https://api.github.com/orgs/VibeCoders-Community/events?per_page=30")
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json() as Promise<GhEvent[]>;
      })
      .then((events) => {
        const items = events.slice(0, 6);
        if (!items.length) return fail();
        feed.innerHTML = items
          .map((e, i) => {
            const action = labels[e.type] ?? labels.other;
            const repo = e.repo.name.split("/")[1] ?? e.repo.name;
            return `<li class="activity-item flex items-center gap-4 border-b border-line py-4 transition-colors duration-200 hover:bg-white/[0.02]" style="animation-delay: ${i * 60}ms">
              <img src="${e.actor.avatar_url}&s=64" alt="" width="32" height="32" loading="lazy" class="h-8 w-8 shrink-0 border border-line" />
              <p class="min-w-0 flex-1 text-sm break-words">
                <span class="font-semibold">${esc(e.actor.display_login)}</span>
                <span class="text-muted"> ${esc(action)} </span>
                <span class="font-mono text-accent-2">${esc(repo)}</span>
              </p>
              <span class="shrink-0 font-mono text-xs text-muted">${relTime(e.created_at)}</span>
            </li>`;
          })
          .join("");
      })
      .catch(fail);
  }
</script>
