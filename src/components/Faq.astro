---
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="faq" class="reveal py-24">
  <div class="mx-auto max-w-5xl px-6">
    <h2 class="mb-4 text-center text-3xl font-extrabold tracking-tight md:text-4xl">{t.faq.title}</h2>
    <p class="mx-auto mb-12 max-w-2xl text-center text-muted">{t.faq.subtitle}</p>
    <div class="mx-auto grid max-w-3xl gap-4">
      {t.faq.items.map((f) => (
        <details class="group rounded-2xl border border-border bg-card px-6 py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="text-accent-2 transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-sm text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
