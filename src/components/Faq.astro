---
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="faq" class="reveal scroll-mt-20 py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mb-12 text-center">
      <p class="eyebrow mb-4">{t.faq.eyebrow}</p>
      <h2 class="mb-4 text-3xl font-extrabold tracking-tight md:text-4xl">{t.faq.title}</h2>
      <p class="mx-auto max-w-2xl text-lg text-muted">{t.faq.subtitle}</p>
    </div>
    <div class="mx-auto grid max-w-3xl gap-4">
      {t.faq.items.map((f) => (
        <details class="group rounded-2xl border border-border bg-card px-6 py-5 transition-colors duration-200 hover:border-accent/50">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="text-xl leading-none text-accent-2 transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <div class="faq-answer">
            <div class="min-h-0 overflow-hidden">
              <p class="pt-3 text-sm text-muted">{f.a}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
