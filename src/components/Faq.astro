---
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="faq" class="reveal scroll-mt-20 border-t border-white/[0.07] py-24">
  <div class="mx-auto max-w-5xl px-6">
    <p class="eyebrow mb-6">{t.faq.eyebrow}</p>
    <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl">{t.faq.title}</h2>
    <p class="mb-12 max-w-2xl text-lg text-muted">{t.faq.subtitle}</p>
    <div class="reveal-stagger grid gap-3">
      {t.faq.items.map((f) => (
        <details class="group border border-white/10 px-5 py-4 transition-colors duration-200 hover:border-accent/50">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="font-mono text-xl leading-none text-accent-3 transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <div class="faq-answer">
            <div class="min-h-0 overflow-hidden">
              <p class="pt-3 text-sm leading-relaxed text-muted">{f.a}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // Symmetric open/close animation for FAQ items: intercept the toggle while
  // closing, collapse .faq-answer via .faq-closing, then remove [open].
  const initFaq = () => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLDetailsElement>("#faq details").forEach((d) => {
      if (d.dataset.faqInit) return;
      d.dataset.faqInit = "1";
      const summary = d.querySelector("summary")!;
      const answer = d.querySelector<HTMLElement>(".faq-answer")!;
      summary.addEventListener("click", (e) => {
        if (reduce) return; // native instant toggle
        e.preventDefault();
        if (!d.open) {
          d.open = true; // opening animates via details[open] CSS
          return;
        }
        d.classList.add("faq-closing");
        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          d.open = false;
          d.classList.remove("faq-closing");
        };
        answer.addEventListener("transitionend", finish, { once: true });
        setTimeout(finish, 350); // fallback if transitionend never fires
      });
    });
  };
  document.addEventListener("astro:page-load", initFaq);
</script>
