---
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);

const iconStyles = [
  "border-accent/40 text-accent",
  "border-accent-3/40 text-accent-3",
  "border-accent-2/40 text-accent-2",
  "border-accent/40 text-accent",
];
---

<section id="features" class="reveal scroll-mt-20 border-t border-white/[0.07] py-24">
  <div class="mx-auto max-w-5xl px-6">
    <p class="eyebrow mb-6">{t.features.eyebrow}</p>
    <h2 class="mb-12 text-3xl font-bold tracking-tight md:text-4xl">
      {t.features.titleStart} <span class="text-accent">{t.features.titleAccent}</span>
    </h2>
    <ul class="reveal-stagger border-t border-white/[0.07]">
      {t.features.items.map((f, i) => (
        <li class="flex gap-5 border-b border-white/[0.07] py-6">
          <span class={`flex h-10 w-10 shrink-0 items-center justify-center border text-lg ${iconStyles[i % iconStyles.length]}`}>
            {f.tag}
          </span>
          <div class="min-w-0">
            <h3 class="mb-1 font-bold">{f.title}</h3>
            <p class="text-sm leading-relaxed text-muted">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
