---
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="features" class="reveal relative scroll-mt-20 border-t border-line py-24">
  <div class="pointer-events-none absolute -right-2 top-6 hidden w-24 lg:block xl:right-10 xl:w-28" aria-hidden="true">
    <img src="/img/pixie-mascot.webp" alt="" width="112" height="112" loading="lazy" class="pixie w-full opacity-90" />
  </div>
  <div class="mx-auto max-w-5xl px-6">
    <p class="eyebrow mb-6">{t.features.eyebrow}</p>
    <h2 class="mb-12 text-3xl font-bold tracking-tight md:text-4xl">
      {t.features.titleStart} <span class="text-accent">{t.features.titleAccent}</span>
    </h2>
    <ul class="reveal-stagger grid gap-5 sm:grid-cols-2">
      {t.features.items.map((f) => (
        <li class="feature p-6">
          <span class="feature-icon mb-4 block text-2xl">{f.tag}</span>
          <h3 class="mb-2 font-bold">{f.title}</h3>
          <p class="text-sm leading-relaxed text-muted">{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
