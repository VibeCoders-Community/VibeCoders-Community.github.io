---
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="features" class="reveal scroll-mt-20 border-y border-border bg-bg-alt py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mb-12 text-center">
      <p class="eyebrow mb-4">{t.features.eyebrow}</p>
      <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">{t.features.title}</h2>
    </div>
    <ul class="mx-auto grid max-w-3xl gap-4">
      {t.features.items.map((f) => (
        <li class="card-hover flex gap-5 rounded-2xl border border-border bg-card p-6">
          <span class="text-2xl">{f.tag}</span>
          <div>
            <h3 class="mb-1 font-bold">{f.title}</h3>
            <p class="text-sm text-muted">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
