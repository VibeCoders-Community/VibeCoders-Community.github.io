---
import { GITHUB_ORG_URL } from "../config";
---

<footer class="py-8">
  <div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-3 px-6 text-sm text-muted">
    <span>© {new Date().getFullYear()} VibeCoders Community</span>
    <a
      href={`${GITHUB_ORG_URL}/VibeCoders-Community.github.io/blob/main/LICENSE`}
      target="_blank"
      rel="noopener"
      class="no-underline transition-colors hover:text-text"
    >
      MIT License · Brand rights reserved
    </a>
  </div>
</footer>
