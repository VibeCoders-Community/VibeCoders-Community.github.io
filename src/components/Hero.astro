---
import { getUi, type Lang } from "../i18n";
import stats from "../data/stats.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
const term = t.hero.terminal;
---

<section class="relative overflow-hidden py-20 md:py-28 lg:py-32">
  <div class="stars pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr]">
      <div class="text-center lg:text-left">
        <p class="hero-in eyebrow mb-6" style="--hd: 0ms">
          {t.hero.badge}
        </p>
        <h1 class="hero-in mb-6 text-5xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl" style="--hd: 90ms">
          <span class="block text-text">{t.hero.titleStart}</span>
          <span class="block text-accent drop-shadow-[0_0_32px_rgba(139,92,246,0.45)]">{t.hero.titleAccent}</span>
        </h1>
        <p class="hero-in mx-auto mb-8 max-w-xl text-lg text-muted lg:mx-0" style="--hd: 180ms">
          {t.hero.subtitle}
        </p>
        <div class="hero-in flex flex-wrap justify-center gap-4 lg:justify-start" style="--hd: 270ms">
          <a
            href="#join"
            class="btn-fx px-7 py-3.5 font-semibold text-white no-underline"
          >
            {t.hero.ctaJoin}
          </a>
          <a
            href="#projects"
            class="btn-ghost border border-white/15 px-7 py-3.5 font-semibold no-underline"
          >
            {t.hero.ctaProjects}
          </a>
        </div>
        <p class="hero-in mt-6" style="--hd: 340ms">
          <span class="inline-block border border-white/15 px-3 py-1.5 font-mono text-xs tracking-wider text-muted">
            {t.hero.chip}
          </span>
        </p>
      </div>

      <div class="hero-in w-full min-w-0" style="--hd: 320ms">
        <div class="terminal" role="img" aria-label={term.title}>
          <div class="terminal-bar">
            <span class="terminal-dot bg-[#ff5f57]"></span>
            <span class="terminal-dot bg-[#febc2e]"></span>
            <span class="terminal-dot bg-[#28c840]"></span>
            <span class="ml-3 font-mono text-xs text-muted">{term.title}</span>
          </div>
          <div id="terminal-body" class="terminal-body font-mono" data-lines={JSON.stringify(term.lines)}>
            {term.lines.map((l) => (
              <div class={`tl tl-${l.t}`}>
                {l.t === "cmd" ? (
                  <>
                    <span class="tl-prompt">$</span> {l.x}
                  </>
                ) : (
                  l.x
                )}
              </div>
            ))}
            <div class="tl tl-cmd">
              <span class="tl-prompt">$</span> <span class="tl-cursor"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-wrap justify-center gap-x-14 gap-y-8 border-t border-white/[0.07] pt-10 lg:justify-start">
      <div class="hero-in" style="--hd: 400ms">
        <span class="block font-mono text-4xl font-semibold text-text" data-count={stats.members} data-suffix="" data-live-members>0</span>
        <span class="mt-1 block font-mono text-xs tracking-wider text-muted uppercase">{t.hero.stats.members}</span>
      </div>
      <div class="hero-in" style="--hd: 480ms">
        <span class="block font-mono text-4xl font-semibold text-accent" data-count="24" data-suffix="/7">0</span>
        <span class="mt-1 block font-mono text-xs tracking-wider text-muted uppercase">{t.hero.stats.support}</span>
      </div>
      <div class="hero-in" style="--hd: 560ms">
        <span class="block font-mono text-4xl font-semibold text-accent-3" data-count="0" data-suffix="%">0</span>
        <span class="mt-1 block font-mono text-xs tracking-wider text-muted uppercase">{t.hero.stats.toxicity}</span>
      </div>
    </div>
  </div>
</section>

<script>
  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.count ?? 0);
    const suffix = el.dataset.suffix ?? "";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.textContent = String(target) + suffix;
      return;
    }
    const dur = 900;
    const t0 = performance.now();
    const tick = (t: number) => {
      const p = Math.min((t - t0) / dur, 1);
      el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))) + (p === 1 ? suffix : "");
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const initCounters = async () => {
    const counters = document.querySelectorAll<HTMLElement>("[data-count]");
    if (!counters.length) return;

    const membersEl = document.querySelector<HTMLElement>("[data-live-members]");
    try {
      const res = await fetch("https://discord.com/api/v9/invites/vibecoders?with_counts=true");
      if (!res.ok) throw new Error(`Discord API ${res.status}`);
      const data = (await res.json()) as { approximate_member_count?: number };
      if (membersEl && typeof data.approximate_member_count === "number") {
        membersEl.dataset.count = String(data.approximate_member_count);
      }
    } catch {
      /* keep the static fallback */
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            animate(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.6 },
    );
    counters.forEach((c) => io.observe(c));
  };

  // Terminal typing loop. The SSR markup is the static "final frame" —
  // with reduced motion (or no JS) it simply stays as rendered.
  const initTerminal = () => {
    const body = document.getElementById("terminal-body");
    if (!body || body.dataset.termInit) return;
    body.dataset.termInit = "1";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    interface TermLine {
      t: "cmd" | "out" | "ok" | "code";
      x: string;
    }
    const lines = JSON.parse(body.dataset.lines!) as TermLine[];
    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const run = async () => {
      while (body.isConnected) {
        body.innerHTML = "";
        for (const line of lines) {
          if (!body.isConnected) return;
          const div = document.createElement("div");
          div.className = `tl tl-${line.t}`;
          body.appendChild(div);
          if (line.t === "cmd") {
            div.innerHTML = '<span class="tl-prompt">$</span> ';
            const text = document.createElement("span");
            const cursor = document.createElement("span");
            cursor.className = "tl-cursor";
            div.append(text, cursor);
            for (const ch of line.x) {
              if (!body.isConnected) return;
              text.textContent += ch;
              await sleep(34 + Math.random() * 40);
            }
            cursor.remove();
            await sleep(420);
          } else {
            div.style.opacity = "0";
            div.textContent = line.x;
            requestAnimationFrame(() => {
              div.style.transition = "opacity 0.3s ease";
              div.style.opacity = "1";
            });
            await sleep(line.t === "ok" ? 650 : 850);
          }
        }
        const end = document.createElement("div");
        end.className = "tl tl-cmd";
        end.innerHTML = '<span class="tl-prompt">$</span> <span class="tl-cursor"></span>';
        body.appendChild(end);
        await sleep(4200);
      }
    };
    void run();
  };

  document.addEventListener("astro:page-load", () => {
    void initCounters();
    initTerminal();
  });
</script>
