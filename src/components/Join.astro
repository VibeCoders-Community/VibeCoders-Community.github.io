---
import { DISCORD_INVITE, GITHUB_ORG_URL } from "../config";
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="join" class="reveal scroll-mt-20 border-t border-white/[0.07] py-28">
  <div class="mx-auto max-w-5xl px-6">
    <p class="eyebrow mb-6">{t.join.eyebrow}</p>
    <h2 class="mb-6 text-4xl font-extrabold tracking-tight md:text-6xl">
      {t.join.titleStart} <span class="text-accent-3 drop-shadow-[0_0_28px_rgba(74,222,128,0.4)]">{t.join.titleAccent}</span>
    </h2>
    <p class="mb-9 max-w-xl text-lg text-muted">
      {t.join.subtitle}
    </p>
    <div class="mb-8 flex flex-wrap gap-4">
      <a
        href={DISCORD_INVITE}
        target="_blank"
        rel="noopener"
        class="btn-fx px-8 py-4 text-lg font-semibold text-white no-underline"
      >
        {t.join.discord}
      </a>
      <a
        href={GITHUB_ORG_URL}
        target="_blank"
        rel="noopener"
        class="btn-ghost border border-white/15 px-8 py-4 text-lg font-semibold no-underline"
      >
        {t.join.github}
      </a>
    </div>
    <p class="mb-4">
      <span class="inline-block border border-accent-3/40 px-3 py-1.5 font-mono text-sm text-accent-3">
        {t.join.chip}
      </span>
    </p>
    <p class="font-mono text-xs text-muted">{t.join.note}</p>
  </div>
</section>
