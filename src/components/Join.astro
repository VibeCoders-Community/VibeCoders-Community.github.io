---
import { DISCORD_INVITE, GITHUB_ORG_URL } from "../config";
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="join" class="reveal scroll-mt-20 border-y border-border bg-bg-alt py-24">
  <div class="mx-auto max-w-5xl px-6 text-center">
    <p class="eyebrow mb-4">{t.join.eyebrow}</p>
    <h2 class="mb-4 text-3xl font-extrabold tracking-tight md:text-4xl">{t.join.title}</h2>
    <p class="mx-auto mb-8 max-w-xl text-lg text-muted">
      {t.join.subtitle}
    </p>
    <div class="mb-6 flex flex-wrap justify-center gap-4">
      <a
        href={DISCORD_INVITE}
        target="_blank"
        rel="noopener"
        class="btn-fx rounded-xl bg-gradient-to-br from-accent to-accent-2 px-8 py-4 text-lg font-semibold text-white no-underline hover:shadow-[0_6px_24px_rgba(124,92,255,0.45)]"
      >
        {t.join.discord}
      </a>
      <a
        href={GITHUB_ORG_URL}
        target="_blank"
        rel="noopener"
        class="btn-ghost rounded-xl border border-border bg-white/[0.02] px-8 py-4 text-lg font-semibold no-underline"
      >
        {t.join.github}
      </a>
    </div>
    <p class="text-sm text-muted">{t.join.note}</p>
  </div>
</section>
