---
import { GITHUB_ORG_URL } from "../config";
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);

const links = [
  { href: "#about", label: t.nav.about },
  { href: "#features", label: t.nav.features },
  { href: "#projects", label: t.nav.projects },
  { href: "#faq", label: t.nav.faq },
  { href: "#team", label: t.nav.team },
  { href: "#join", label: t.nav.join },
];

const langSwitch = [
  { href: "/", label: "EN", active: lang === "en" },
  { href: "/ru/", label: "RU", active: lang === "ru" },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center gap-6 px-6">
    <a href="#top" class="flex items-center gap-2 text-lg font-extrabold no-underline">
      <img src="/logo.svg" alt="VibeCoders logo" width="28" height="28" class="rounded-lg" />
      VibeCoders
    </a>
    <nav id="nav-links" class="ml-auto hidden gap-6 md:flex">
      {links.map((l) => (
        <a href={l.href} class="nav-link text-sm text-muted no-underline hover:text-text">
          {l.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-1 rounded-lg border border-border bg-white/[0.02] p-1 font-mono text-xs">
      {langSwitch.map((l) => (
        <a
          href={l.href}
          class:list={[
            "rounded-md px-2 py-1 no-underline transition-colors",
            l.active ? "bg-accent text-white" : "text-muted hover:text-text",
          ]}
        >
          {l.label}
        </a>
      ))}
    </div>
    <a
      href={GITHUB_ORG_URL}
      target="_blank"
      rel="noopener"
      class="btn-ghost hidden rounded-lg border border-border bg-white/[0.02] px-4 py-2 text-sm font-semibold no-underline sm:block"
    >
      GitHub
    </a>
    <button id="burger" aria-label="Menu" aria-expanded="false" class="flex cursor-pointer flex-col gap-1.5 border-0 bg-transparent p-1.5 md:hidden">
      <span class="h-0.5 w-5 rounded bg-text"></span>
      <span class="h-0.5 w-5 rounded bg-text"></span>
      <span class="h-0.5 w-5 rounded bg-text"></span>
    </button>
  </div>
  <nav id="mobile-menu" class="hidden flex-col gap-4 border-b border-border bg-bg-alt px-6 py-4 md:hidden">
    {links.map((l) => (
      <a href={l.href} class="mobile-link text-sm text-muted no-underline transition-colors duration-200 hover:text-text">
        {l.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const initNav = () => {
    const burger = document.getElementById("burger")!;
    const menu = document.getElementById("mobile-menu")!;
    burger.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden");
      burger.setAttribute("aria-expanded", String(!open));
    });
    menu.querySelectorAll(".mobile-link").forEach((a) =>
      a.addEventListener("click", () => menu.classList.add("hidden")),
    );

    // Scrollspy: highlight the nav link of the section in view.
    const w = window as unknown as { __navSpy?: IntersectionObserver };
    w.__navSpy?.disconnect();
    const spyLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("#nav-links a[href^='#']"),
    );
    const sections = spyLinks
      .map((a) => document.querySelector<HTMLElement>(a.hash))
      .filter((s): s is HTMLElement => s !== null);
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          spyLinks.forEach((a) =>
            a.classList.toggle("is-active", a.hash === `#${en.target.id}`),
          );
        });
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((s) => spy.observe(s));
    w.__navSpy = spy;
  };
  document.addEventListener("astro:page-load", initNav);
</script>
