---
import { GITHUB_ORG_URL } from "../config";
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);

const links = [
  { href: "#about", label: t.nav.about },
  { href: "#features", label: t.nav.features },
  { href: "#projects", label: t.nav.projects },
  { href: "#faq", label: t.nav.faq },
  { href: "#team", label: t.nav.team },
  { href: "#join", label: t.nav.join },
];

const langSwitch = [
  { href: "/", label: "EN", active: lang === "en" },
  { href: "/ru/", label: "RU", active: lang === "ru" },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/95">
  <div class="mx-auto flex h-16 max-w-5xl items-center gap-4 px-4 sm:px-6 md:gap-6">
    <a href="#top" class="flex shrink-0 items-center gap-2 font-display text-base font-bold no-underline">
      <img src="/img/logo-bolt.webp" alt="VibeCoders logo" width="22" height="22" />
      VibeCoders
    </a>
    <nav id="nav-links" class="ml-auto hidden gap-6 md:flex">
      {links.map((l) => (
        <a href={l.href} class="nav-link font-mono text-[13px] text-muted no-underline hover:text-text">
          {l.label}
        </a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-1 border border-line bg-white/[0.02] p-1 font-mono text-xs md:ml-0">
      {langSwitch.map((l) => (
        <a
          href={l.href}
          class:list={[
            "px-2.5 py-1.5 no-underline transition-colors",
            l.active ? "bg-accent text-white" : "text-muted hover:text-text",
          ]}
        >
          {l.label}
        </a>
      ))}
    </div>
    <a
      href={GITHUB_ORG_URL}
      target="_blank"
      rel="noopener"
      class="btn-ghost hidden px-4 py-2 text-sm font-semibold no-underline sm:block"
    >
      GitHub
    </a>
    <button
      id="burger"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex h-11 w-11 shrink-0 cursor-pointer flex-col items-center justify-center gap-1.5 border border-line bg-white/[0.03] md:hidden"
    >
      <span class="h-0.5 w-5 bg-text"></span>
      <span class="h-0.5 w-5 bg-text"></span>
      <span class="h-0.5 w-5 bg-text"></span>
    </button>
  </div>
  <nav id="mobile-menu" class="hidden flex-col gap-1 border-b border-line bg-bg-alt px-4 py-3 md:hidden">
    {links.map((l) => (
      <a href={l.href} class="mobile-link block px-3 py-3 font-mono text-sm text-muted no-underline transition-colors duration-200 hover:bg-white/[0.04] hover:text-text">
        {l.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const initNav = () => {
    const burger = document.getElementById("burger")!;
    const menu = document.getElementById("mobile-menu")!;
    // Guard: with ClientRouter the header can survive a page swap —
    // without this, a second astro:page-load would double-bind the toggle.
    if (!burger.dataset.init) {
      burger.dataset.init = "1";
      const setMenu = (open: boolean) => {
        menu.classList.toggle("hidden", !open);
        menu.classList.toggle("flex", open);
        burger.setAttribute("aria-expanded", String(open));
      };
      burger.addEventListener("click", () => {
        setMenu(menu.classList.contains("hidden"));
      });
      menu.querySelectorAll(".mobile-link").forEach((a) =>
        a.addEventListener("click", () => setMenu(false)),
      );
    }

    // Scrollspy: highlight the nav link of the section in view.
    const w = window as unknown as { __navSpy?: IntersectionObserver };
    w.__navSpy?.disconnect();
    const spyLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("#nav-links a[href^='#']"),
    );
    const sections = spyLinks
      .map((a) => document.querySelector<HTMLElement>(a.hash))
      .filter((s): s is HTMLElement => s !== null);
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          spyLinks.forEach((a) =>
            a.classList.toggle("is-active", a.hash === `#${en.target.id}`),
          );
        });
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((s) => spy.observe(s));
    w.__navSpy = spy;
  };
  document.addEventListener("astro:page-load", initNav);
</script>
