---
import { GITHUB_ORG } from "../config";
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);

const prefixColors: Record<string, string> = {
  $: "text-accent-3",
  ">": "text-accent-2",
  "#": "text-muted",
};
---

<section id="projects" class="reveal scroll-mt-20 border-t border-white/[0.07] py-24">
  <div class="mx-auto max-w-5xl px-6">
    <p class="eyebrow mb-6">{t.projects.eyebrow}</p>
    <h2 class="mb-4 text-3xl font-bold tracking-tight md:text-4xl">
      {t.projects.titleStart} <span class="text-accent">{t.projects.titleAccent}</span>
    </h2>
    <p class="mb-10 max-w-2xl text-lg text-muted">{t.projects.subtitle}</p>

    <div class="terminal mb-10 p-5 font-mono text-sm leading-8">
      {t.projects.term.map((l) => (
        <div class={prefixColors[l.p] ?? "text-muted"}>
          <span class="font-semibold">{l.p}</span> {l.x}
        </div>
      ))}
    </div>

    <div id="repo-grid" class="reveal-stagger border-t border-white/[0.07]" data-org={GITHUB_ORG}>
      {t.projects.cards.map((c) => (
        <div data-repo={c.repo}>
          <a
            href={`https://github.com/${GITHUB_ORG}/${c.repo}`}
            target="_blank"
            rel="noopener"
            class="flex flex-col gap-1 border-b border-white/[0.07] px-2 py-5 no-underline transition-colors duration-200 hover:bg-white/[0.02] sm:flex-row sm:items-baseline sm:gap-6"
          >
            <h3 class="shrink-0 font-bold break-words sm:w-64">{c.name}</h3>
            <p class="min-w-0 flex-1 text-sm text-muted">{c.description}</p>
            <span class="flex shrink-0 gap-4 font-mono text-xs text-muted">
              <span data-repo-language></span>
              <span data-repo-stars></span>
            </span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  interface Repo {
    name: string;
    language: string | null;
    stargazers_count: number;
  }

  const initRepos = async () => {
    const grid = document.getElementById("repo-grid");
    if (!grid) return;
    const org = grid.dataset.org!;
    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

    // GitHub linguist colors for the language dot.
    const LANG_COLORS: Record<string, string> = {
      JavaScript: "#f1e05a",
      TypeScript: "#3178c6",
      Python: "#3572A5",
      Rust: "#dea584",
      Astro: "#ff5a03",
      HTML: "#e34c26",
      CSS: "#563d7c",
      Shell: "#89e051",
      "C++": "#f34b7d",
      C: "#555555",
      Java: "#b07219",
      Go: "#00ADD8",
      Lua: "#000080",
      Svelte: "#ff3e00",
      Vue: "#41b883",
    };

    try {
      const res = await fetch(`https://api.github.com/orgs/${org}/repos?per_page=100`);
      if (!res.ok) throw new Error(`GitHub API ${res.status}`);
      const repos = (await res.json()) as Repo[];

      grid.querySelectorAll<HTMLElement>("[data-repo]").forEach((card) => {
        const repo = repos.find((r) => r.name === card.dataset.repo);
        if (!repo) return;
        const langEl = card.querySelector<HTMLElement>("[data-repo-language]");
        const starsEl = card.querySelector<HTMLElement>("[data-repo-stars]");
        if (langEl && repo.language) {
          const color = LANG_COLORS[repo.language] ?? "#9c96b8";
          langEl.innerHTML = `<span style="color: ${color}">●</span> ${esc(repo.language)}`;
        }
        if (starsEl) starsEl.textContent = `★ ${repo.stargazers_count}`;
      });
    } catch {
      /* static rows stay as the fallback */
    }
  };
  document.addEventListener("astro:page-load", () => {
    void initRepos();
  });
</script>
