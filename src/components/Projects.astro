---
import { GITHUB_ORG } from "../config";
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="projects" class="reveal scroll-mt-20 py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mb-12 text-center">
      <p class="eyebrow mb-4">{t.projects.eyebrow}</p>
      <h2 class="title-glow mb-4 text-3xl font-extrabold tracking-tight md:text-4xl">{t.projects.title}</h2>
      <p class="mx-auto max-w-2xl text-lg text-muted">
        {t.projects.subtitle}
      </p>
    </div>
    <div id="repo-grid" class="reveal-stagger grid gap-6 sm:grid-cols-2" data-org={GITHUB_ORG}>
      {t.projects.cards.map((c) => (
        <article
          class="card-hover glass rounded-2xl"
          data-repo={c.repo}
        >
          <a
            href={`https://github.com/${GITHUB_ORG}/${c.repo}`}
            target="_blank"
            rel="noopener"
            class="block p-6 no-underline"
          >
            <h3 class="mb-2 text-lg font-bold">{c.name}</h3>
            <p class="text-sm text-muted">{c.description}</p>
            <div class="mt-4 flex gap-4 font-mono text-xs text-muted">
              <span data-repo-language></span>
              <span data-repo-stars></span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  interface Repo {
    name: string;
    language: string | null;
    stargazers_count: number;
  }

  const initRepos = async () => {
    const grid = document.getElementById("repo-grid");
    if (!grid) return;
    const org = grid.dataset.org!;
    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

    // GitHub linguist colors for the language dot.
    const LANG_COLORS: Record<string, string> = {
      JavaScript: "#f1e05a",
      TypeScript: "#3178c6",
      Python: "#3572A5",
      Rust: "#dea584",
      Astro: "#ff5a03",
      HTML: "#e34c26",
      CSS: "#563d7c",
      Shell: "#89e051",
      "C++": "#f34b7d",
      C: "#555555",
      Java: "#b07219",
      Go: "#00ADD8",
      Lua: "#000080",
      Svelte: "#ff3e00",
      Vue: "#41b883",
    };

    try {
      const res = await fetch(`https://api.github.com/orgs/${org}/repos?per_page=100`);
      if (!res.ok) throw new Error(`GitHub API ${res.status}`);
      const repos = (await res.json()) as Repo[];

      grid.querySelectorAll<HTMLElement>("[data-repo]").forEach((card) => {
        const repo = repos.find((r) => r.name === card.dataset.repo);
        if (!repo) return;
        const langEl = card.querySelector<HTMLElement>("[data-repo-language]");
        const starsEl = card.querySelector<HTMLElement>("[data-repo-stars]");
        if (langEl && repo.language) {
          const color = LANG_COLORS[repo.language] ?? "#9aa4b8";
          langEl.innerHTML = `<span style="color: ${color}">●</span> ${esc(repo.language)}`;
        }
        if (starsEl) starsEl.textContent = `★ ${repo.stargazers_count}`;
      });
    } catch {
      /* static cards stay as the fallback */
    }
  };
  document.addEventListener("astro:page-load", () => {
    void initRepos();
  });
</script>
