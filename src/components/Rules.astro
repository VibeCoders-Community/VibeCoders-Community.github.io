---
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="rules" class="reveal border-y border-border bg-bg-alt py-24">
  <div class="mx-auto max-w-5xl px-6">
    <h2 class="mb-4 text-center text-3xl font-extrabold tracking-tight md:text-4xl">{t.rules.title}</h2>
    <p class="mx-auto mb-12 max-w-2xl text-center text-muted">{t.rules.subtitle}</p>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {t.rules.items.map((r, i) => (
        <article class="rounded-2xl border border-border bg-card p-7">
          <div class="mb-4 font-mono text-sm font-semibold text-accent-2">
            {String(i + 1).padStart(2, "0")}
          </div>
          <h3 class="mb-2 text-lg font-bold">{r.title}</h3>
          <p class="text-sm text-muted">{r.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
