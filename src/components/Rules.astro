---
import { getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
---

<section id="rules" class="reveal scroll-mt-20 border-y border-white/[0.06] py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mb-12 text-center">
      <p class="eyebrow mb-4">{t.rules.eyebrow}</p>
      <h2 class="title-glow mb-4 text-3xl font-extrabold tracking-tight md:text-4xl">{t.rules.title}</h2>
      <p class="mx-auto max-w-2xl text-lg text-muted">{t.rules.subtitle}</p>
    </div>
    <div class="reveal-stagger grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {t.rules.items.map((r, i) => (
        <article class="card-hover glass rounded-2xl p-6">
          <div class="mb-4 font-mono text-sm font-semibold text-accent-2">
            {String(i + 1).padStart(2, "0")}
          </div>
          <h3 class="mb-2 text-lg font-bold">{r.title}</h3>
          <p class="text-sm text-muted">{r.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
