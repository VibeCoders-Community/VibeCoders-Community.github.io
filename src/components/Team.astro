---
import { getUi, type Lang } from "../i18n";
import teamData from "../data/team.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);

// Owner is shown in a dedicated card, not in the auto-fetched list.
const OWNER_ID = "662566746221314069";
const overrides = t.team.overrides as Record<string, { role: string; text: string }>;
const members = teamData
  .filter((m) => m.id !== OWNER_ID)
  .map((m) => ({
    ...m,
    ...(overrides[m.username] ?? t.team.defaultMember),
  }));
---

<section id="team" class="reveal scroll-mt-20 border-y border-border bg-bg-alt py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mb-12 text-center">
      <p class="eyebrow mb-4">{t.team.eyebrow}</p>
      <h2 class="mb-4 text-3xl font-extrabold tracking-tight md:text-4xl">{t.team.title}</h2>
      <p class="mx-auto max-w-2xl text-lg text-muted">{t.team.subtitle}</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <article class="card-hover rounded-2xl border border-accent/40 bg-card p-6">
        <img
          src="https://github.com/DARKPIX404.png"
          alt="DARKPIX avatar"
          width="64"
          height="64"
          loading="lazy"
          class="mb-4 h-16 w-16 rounded-full ring-2 ring-accent/50"
        />
        <h3 class="text-lg font-bold">
          DARKPIX
          <span class="ml-1 text-sm font-normal text-muted">(Vladislav Borodatyy)</span>
        </h3>
        <p class="mb-2 font-mono text-xs font-semibold tracking-wider text-accent-2 uppercase">
          {t.team.owner.role}
        </p>
        <p class="text-sm text-muted">{t.team.owner.text}</p>
      </article>
      {members.map((m) => (
        <article class="card-hover rounded-2xl border border-border bg-card p-6">
          {m.avatar ? (
            <img
              src={m.avatar}
              alt={`${m.display} avatar`}
              width="64"
              height="64"
              loading="lazy"
              class="mb-4 h-16 w-16 rounded-full object-cover ring-2 ring-border"
            />
          ) : (
            <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-accent to-accent-2 text-2xl font-extrabold text-white">
              {m.display.charAt(0).toUpperCase()}
            </div>
          )}
          <h3 class="text-lg font-bold">{m.display}</h3>
          <p class="mb-2 font-mono text-xs font-semibold tracking-wider text-accent-2 uppercase">
            {m.role}
          </p>
          <p class="text-sm text-muted">{m.text}</p>
        </article>
      ))}
      {t.team.roles.map((r) => (
        <article class="card-hover rounded-2xl border border-border bg-card p-6">
          <div class="mb-4 text-3xl">{r.icon}</div>
          <h3 class="mb-2 text-lg font-bold">{r.title}</h3>
          <p class="text-sm text-muted">{r.text}</p>
        </article>
      ))}
    </div>
    <h3 class="mt-16 mb-8 text-center text-2xl font-extrabold tracking-tight">{t.team.path.title}</h3>
    <div class="grid gap-6 sm:grid-cols-3">
      {t.team.path.steps.map((s) => (
        <article class="card-hover rounded-2xl border border-border bg-card p-6">
          <h4 class="mb-2 font-bold text-accent-2">{s.title}</h4>
          <p class="text-sm text-muted">{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
