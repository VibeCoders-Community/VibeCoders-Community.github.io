---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getUi, type Lang } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;
const t = getUi(lang);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const enUrl = new URL("/", Astro.site);
const ruUrl = new URL("/ru/", Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="font-sans antialiased leading-relaxed">
    <div class="aurora" aria-hidden="true">
      <div class="aurora-blob aurora-blob-1"></div>
      <div class="aurora-blob aurora-blob-2"></div>
      <div class="aurora-blob aurora-blob-3"></div>
    </div>
    <div class="noise" aria-hidden="true"></div>
    <div id="scroll-progress" aria-hidden="true"></div>
    <slot />
    <button id="back-to-top" aria-label={t.a11y.backToTop} title={t.a11y.backToTop}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5"></path>
        <path d="m5 12 7-7 7 7"></path>
      </svg>
    </button>
    <script>
      const initReveal = () => {
        const els = document.querySelectorAll<HTMLElement>(
          ".reveal:not(.is-visible), .reveal-stagger:not(.is-visible)",
        );
        if (!els.length) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 },
        );
        els.forEach((el) => io.observe(el));
      };
      document.addEventListener("astro:page-load", initReveal);

      // Cursor-tracked glow + pixel-cube button effects.
      const initFx = () => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        // Spotlight / card glow: track pointer, expose --mx/--my in px.
        const track = (el: HTMLElement) => {
          if (el.dataset.fxTrack) return;
          el.dataset.fxTrack = "1";
          el.addEventListener("pointermove", (ev) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty("--mx", `${ev.clientX - r.left}px`);
            el.style.setProperty("--my", `${ev.clientY - r.top}px`);
          });
        };
        document
          .querySelectorAll<HTMLElement>(".spotlight, article")
          .forEach(track);

        // Pixel grid overlay for .btn-fx buttons.
        document
          .querySelectorAll<HTMLElement>(".btn-fx")
          .forEach((btn) => {
            if (btn.querySelector(".fx-grid")) return;
            const grid = document.createElement("span");
            grid.className = "fx-grid";
            grid.setAttribute("aria-hidden", "true");
            for (let i = 0; i < 48; i++) {
              const cell = document.createElement("span");
              cell.className = "fx-cell";
              cell.style.setProperty("--d", `${Math.floor(Math.random() * 350)}ms`);
              grid.appendChild(cell);
            }
            btn.appendChild(grid);
          });
      };
      document.addEventListener("astro:page-load", initFx);

      // Scroll progress bar + back-to-top. Listeners are bound once (they
      // survive ClientRouter swaps); elements are re-queried on every update.
      const initScrollFx = () => {
        const w = window as unknown as { __scrollFxBound?: boolean };
        const update = () => {
          const bar = document.getElementById("scroll-progress");
          const topBtn = document.getElementById("back-to-top");
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? window.scrollY / max : 0;
          bar?.style.setProperty("transform", `scaleX(${Math.min(p, 1)})`);
          topBtn?.classList.toggle("is-visible", window.scrollY > 600);
        };
        update();
        if (w.__scrollFxBound) return;
        w.__scrollFxBound = true;
        let ticking = false;
        window.addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(() => {
                ticking = false;
                update();
              });
            }
          },
          { passive: true },
        );
        document.addEventListener("click", (e) => {
          if (!(e.target as HTMLElement).closest("#back-to-top")) return;
          const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
        });
      };
      document.addEventListener("astro:page-load", initScrollFx);
    </script>
  </body>
</html>
