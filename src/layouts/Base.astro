---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import type { Lang } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const enUrl = new URL("/", Astro.site);
const ruUrl = new URL("/ru/", Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="font-sans antialiased leading-relaxed">
    <slot />
    <script>
      const initReveal = () => {
        const els = document.querySelectorAll<HTMLElement>(".reveal:not(.is-visible)");
        if (!els.length) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 },
        );
        els.forEach((el) => io.observe(el));
      };
      document.addEventListener("astro:page-load", initReveal);

      // Cursor-tracked glow + pixel-cube button effects.
      const initFx = () => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        // Spotlight / card glow: track pointer, expose --mx/--my in px.
        const track = (el: HTMLElement) => {
          if (el.dataset.fxTrack) return;
          el.dataset.fxTrack = "1";
          el.addEventListener("pointermove", (ev) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty("--mx", `${ev.clientX - r.left}px`);
            el.style.setProperty("--my", `${ev.clientY - r.top}px`);
          });
        };
        document
          .querySelectorAll<HTMLElement>(".spotlight, article")
          .forEach(track);

        // Pixel grid overlay for .btn-fx buttons.
        document
          .querySelectorAll<HTMLElement>(".btn-fx")
          .forEach((btn) => {
            if (btn.querySelector(".fx-grid")) return;
            const grid = document.createElement("span");
            grid.className = "fx-grid";
            grid.setAttribute("aria-hidden", "true");
            for (let i = 0; i < 48; i++) {
              const cell = document.createElement("span");
              cell.className = "fx-cell";
              cell.style.setProperty("--d", `${Math.floor(Math.random() * 350)}ms`);
              grid.appendChild(cell);
            }
            btn.appendChild(grid);
          });
      };
      document.addEventListener("astro:page-load", initFx);
    </script>
  </body>
</html>
