---
import Base from "../layouts/Base.astro";
import { DISCORD_INVITE } from "../config";
---

<Base title="404 — Page not found | VibeCoders" description="This page doesn't exist — but the vibes do." lang="en">
  <main class="relative flex min-h-screen items-center justify-center px-6">
    <div class="text-center">
      <p class="eyebrow mb-6">lost in the vibes</p>
      <h1 class="hero-accent bg-gradient-to-br from-accent via-accent-2 to-accent-3 bg-clip-text text-8xl font-extrabold tracking-tight text-transparent drop-shadow-[0_0_32px_rgba(124,92,255,0.4)] md:text-9xl">
        404
      </h1>
      <p class="mx-auto mt-5 max-w-md text-lg text-muted">
        This page drifted off into the void. Let's get you back to the good vibes.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="btn-fx rounded-xl bg-gradient-to-br from-accent to-accent-2 px-7 py-3.5 font-semibold text-white no-underline"
        >
          Back home
        </a>
        <a
          href={DISCORD_INVITE}
          target="_blank"
          rel="noopener"
          class="btn-ghost rounded-xl border border-white/10 bg-white/[0.03] px-7 py-3.5 font-semibold no-underline backdrop-blur-sm"
        >
          Join our Discord
        </a>
      </div>
    </div>
  </main>
</Base>
